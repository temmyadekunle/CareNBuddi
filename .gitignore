# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env*.example

# scratch working files
/tmp/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# netlify
.netlify/
tmp-*.txt

# local Supabase CLI scratch (created when the CLI runs via npx)
/supabase/.temp/

# generated one-off verification artifacts at the repo root (regenerable by
# rerunning the harnesses; the reviewed fixtures live in tests/pglite/ and
# stay tracked — the leading slashes keep these rules root-anchored only)
/bootstrap-output.txt
/test-output.txt
/privacy-output.txt
/verify-output.txt
/defence-output.txt
/replay-output.txt
/bootstrap.json
/hardened.json
/privacy.json

# cloudflare
.wrangler/
.open-next/
# wrangler dev local secrets + dev logs
.dev.vars
wrangler-*.log
deploy.log

# android
/android/local.properties
/android/keystore.properties
/android/keystore/
/android/app/src/main/assets/
/android/.gradle/
/android/build/
/android/app/build/
/android/gradle/
/android/gradlew
/android/gradlew.bat
/apk-output/


tail.log
