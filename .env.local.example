# CareNBuddi backend (Supabase)
# Copy this file to .env.local and fill in the values from
# Supabase → Project Settings → API.
# Both values are safe to expose in the browser: access is controlled by the
# row level security policies in supabase/migrations/0001_init.sql.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# AI Health Guide — NOT frontend env, do not put an AI key here.
# The AI endpoint runs in a Cloudflare Worker (worker/index.ts). Configure it with:
#   npx wrangler@4 secret put AI_API_KEY
# plus optional wrangler.jsonc vars: AI_BASE_URL, AI_MODEL.
# Anything in .env.local ships to the browser bundle; the Worker secret never does.